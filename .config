# ==========================================
# 1. 目标平台：Nokia XG-040G-TF (Airoha AN7581)
# ==========================================
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_nokia_xg-040g-tf-ubi=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_UBIFS_PREREQ=y

# ==========================================
# 2. 基础 Web 管理界面与中文语言包
# ==========================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ==========================================
# 3. 硬件 PPE 转发与底层硬件加速
# ==========================================
CONFIG_PACKAGE_kmod-flow-offload=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-nft-nat=y

# ==========================================
# 4. Airoha NPU 仪表盘 + CPU 调频/节能/温度支持
# ==========================================
CONFIG_PACKAGE_luci-app-airoha-npu=y
# 必须开启内核与 BusyBox 的 devmem，否则插件无法读取芯片寄存器
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
# CPU 调频调速器底层驱动
CONFIG_PACKAGE_kmod-cpufreq-governor=y
CONFIG_PACKAGE_kmod-hwmon-core=y
CONFIG_PACKAGE_lm-sensors=y
# [新增] CPU 频率调节图形化 Web 界面
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

# ==========================================
# 5. 联通拨号、VLAN 801 与 IPTV 转发
# ==========================================
CONFIG_PACKAGE_kmod-8021q=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_igmpproxy=y
CONFIG_PACKAGE_omciproxy=y
# [新增] 高性能 IPTV 组播转单播 (支持秒切台)
CONFIG_PACKAGE_msd_lite=y
CONFIG_PACKAGE_luci-app-msd_lite=y
CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn=y
# [新增] 经典备选组播转单播代理
CONFIG_PACKAGE_udpxy=y
CONFIG_PACKAGE_luci-app-udpxy=y
CONFIG_PACKAGE_luci-i18n-udpxy-zh-cn=y

# ==========================================
# 6. 基础系统工具
# ==========================================
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump=y
