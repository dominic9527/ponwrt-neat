
# ============================================================
# Nokia XG-040G-TF UBI / Airoha AN7581
# PonWrt minimal gateway configuration
# ============================================================

# 1. Target device
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-tf-ubi=y
CONFIG_TARGET_PROFILE="DEVICE_nokia_xg-040g-tf-ubi"

# ============================================================
# 2. PON drivers and management
# ============================================================

CONFIG_MODULE_DEFAULT_kmod-airoha-en7572=y
CONFIG_MODULE_DEFAULT_kmod-airoha-paged-bosa=y
CONFIG_MODULE_DEFAULT_kmod-airoha-xpon=y

CONFIG_PACKAGE_kmod-airoha-en7572=y
CONFIG_PACKAGE_kmod-airoha-paged-bosa=y
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
CONFIG_PACKAGE_kmod-airoha-xpon=y

CONFIG_PACKAGE_airoha-pon-debug=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_luci-app-pon=y

# ============================================================
# 3. Airoha NPU / PPE / Frame Engine
# ============================================================

CONFIG_KERNEL_DEVMEM=y

CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y

CONFIG_PACKAGE_kmod-dummy=y

CONFIG_PACKAGE_airoha-en7581-npu-firmware=y
CONFIG_PACKAGE_airoha-an7583-npu-firmware=y
CONFIG_PACKAGE_airoha-en8811h-firmware=y

CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y

# ============================================================
# 4. IPTV - msd_lite only
# ============================================================

CONFIG_PACKAGE_msd_lite=y
CONFIG_PACKAGE_luci-app-msd_lite=y
CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn=y

# msd_lite may need raw iptables support; keep it
CONFIG_PACKAGE_kmod-ipt-raw=y

# Do not use igmpproxy or the separate LuCI IPTV app
# CONFIG_PACKAGE_igmpproxy is not set
# CONFIG_PACKAGE_luci-app-iptv is not set

# Remove upstream default IPTV app
# CONFIG_MODULE_DEFAULT_luci-app-iptv is not set
# CONFIG_MODULE_DEFAULT_luci-i18n-iptv-zh-cn is not set

# ============================================================
# 5. Airoha SoC temperature / frequency
# ============================================================

# Keep kernel thermal and hwmon interfaces
CONFIG_PACKAGE_kmod-hwmon-core=y
CONFIG_PACKAGE_kmod-thermal=y

# Airoha NPU dashboard handles CPU frequency and temperature
# Generic cpufreq UI and lm-sensors are not needed
# CONFIG_PACKAGE_lm-sensors is not set
# CONFIG_PACKAGE_cpufreq is not set
# CONFIG_PACKAGE_luci-app-cpufreq is not set
# CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn is not set

# ============================================================
# 6. Tailscale
# ============================================================

CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_luci-app-tailscale-community=y

# ============================================================
# 7. LuCI / Chinese / theme
# ============================================================

CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y

CONFIG_PACKAGE_luci-theme-argon=y

CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_autocore-arm=y

# ============================================================
# 8. Basic system tools
# ============================================================

CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ca-bundle=y

# UPnP
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# ============================================================
# 9. Remove unnecessary USB modules
# Keep USB_SUPPORT enabled at kernel level.
# Do not remove NAND / UBI / FIT / bootloader components.
# ============================================================

# CONFIG_MODULE_DEFAULT_kmod-usb-ledtrig-usbport is not set
# CONFIG_MODULE_DEFAULT_kmod-usb-storage is not set
# CONFIG_MODULE_DEFAULT_kmod-usb-storage-uas is not set
# CONFIG_MODULE_DEFAULT_kmod-usb3 is not set
